// The single search screen, opened by the library's search icon or Ctrl K.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, SearchField, Card, Chip, ActionInput } from "components.slint";
import { OperationBanner } from "library.slint";
import { LibraryRow, PagePreview } from "library.slint";

component ResultRow inherits Rectangle {
    in property <LibraryRow> score;
    callback clicked();
    height: root.score.snippet_match != "" ? 88px : 76px;
    border-radius: 18px;
    background: input.pressed ? Theme.field : transparent;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.score.title;
    accessible-description: root.score.snippet_before + root.score.snippet_match + root.score.snippet_after;
    accessible-action-default => { root.clicked(); }
    forward-focus: input;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        VerticalLayout { alignment: center; PagePreview { score: root.score; width: 40px; height: 52px; border-radius: 6px; } }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.score.title; color: Theme.foreground; font-size: 16px; font-weight: 600; overflow: elide; }
            if root.score.snippet_match == "" : Text {
                text: (root.score.id != "" && root.score.composer_or_artist != "" ? root.score.id + " · " + root.score.composer_or_artist : root.score.id + root.score.composer_or_artist);
                color: Theme.muted; font-size: 14px; overflow: elide;
            }
            if root.score.snippet_match != "" : Rectangle {
                height: 20px;
                clip: true;
                HorizontalLayout {
                    Text { text: root.score.snippet_before; color: Theme.muted; font-size: 14px; }
                    Text { text: root.score.snippet_match; color: Theme.accent-text; font-size: 14px; font-weight: 700; }
                    Text { text: root.score.snippet_after; color: Theme.muted; font-size: 14px; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
    }
    input := ActionInput { clicked => { self.focus(); root.clicked(); } }
}

export component SearchScreen inherits Rectangle {
    in-out property <string> query;
    in property <length> available-height;
    in property <length> available-width;
    in property <string> scope;
    in property <[LibraryRow]> rows;
    in property <string> progress-text;
    in property <bool> busy;
    in property <float> fraction;
    in property <bool> cancel-enabled;
    in property <bool> acknowledge-enabled;
    in property <bool> failed;
    in property <bool> hardware-keyboard-present;
    in property <bool> voice-available;
    callback voice-requested();
    callback cancel();
    callback acknowledge();
    callback query-edited(string);
    callback scope-changed(string);
    callback close();
    callback chosen(string);
    public function focus-field() { field.focus(); }
    max-height: root.available-height;
    background: Theme.background;

    VerticalLayout {
        padding: root.available-width < 600px ? 16px : 24px;
        padding-bottom: 16px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; IconButton { label: "Back to library"; icon: @image-url("material-icons/arrow-back.svg"); clicked => { root.close(); } } }
            field := SearchField {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: "Search titles, composers, tags or lyrics";
                hardware-keyboard-present: root.hardware-keyboard-present;
                edited(value) => { root.query-edited(value); }
            }
            if root.voice-available : VerticalLayout {
                alignment: center;
                IconButton {
                    label: "Search by voice";
                    icon: @image-url("material-icons/mic.svg");
                    clicked => { root.voice-requested(); }
                }
            }
        }
        if root.progress-text != "" : OperationBanner {
            text: root.progress-text;
            busy: root.busy;
            failed: root.failed;
            fraction: root.fraction;
            cancel-enabled: root.cancel-enabled;
            acknowledge-enabled: root.acknowledge-enabled;
            cancel => { root.cancel(); }
            acknowledge => { root.acknowledge(); }
        }
        Flickable {
            interactive: self.content-width > self.width;
            min-height: 48px;
            max-height: 48px;
            content-width: chips.preferred-width;
            chips := HorizontalLayout {
                padding-left: 56px;
                spacing: 8px;
                alignment: start;
                Chip { label: "All"; selected: root.scope == "everything"; clicked => { root.scope-changed("everything"); } }
                Chip { label: "Titles"; selected: root.scope == "titles"; clicked => { root.scope-changed("titles"); } }
                Chip { label: "Composers"; selected: root.scope == "composers"; clicked => { root.scope-changed("composers"); } }
                Chip { label: "Lyrics"; selected: root.scope == "text"; clicked => { root.scope-changed("text"); } }
                Chip { label: "Tags"; selected: root.scope == "tags"; clicked => { root.scope-changed("tags"); } }
            }
        }
        if root.query != "" && root.rows.length > 0 : Card {
            vertical-stretch: 1;
            ListView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                for score in root.rows : ResultRow { score: score; clicked => { root.chosen(score.note_key); } }
            }
        }
        if root.query != "" && root.rows.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 8px;
            Text { text: "No scores found"; color: Theme.foreground; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
            Text { text: "Try another word, or switch the scope above."; color: Theme.muted; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        }
        if root.query == "" : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 8px;
            HorizontalLayout { alignment: center; Glyph { kind: "search"; width: 40px; height: 40px; } }
            Text { text: "Search your library"; color: Theme.foreground; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
            Text { text: "Find scores by title, composer, tag or lyrics."; color: Theme.muted; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}
