// One UI library: side panel, large title, thumbnail grid and operation banner.
import { ListView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, ScanButton, PillButton, Card, NavRow, Chip, StatusBadge, ActionInput } from "components.slint";

export struct LibraryRow {
    id: string,
    title: string,
    composer_or_artist: string,
    tags: string,
    status: string,
    note_key: string,
    relative_path: string,
    text_pending: bool,
    has_thumbnail: bool,
    thumbnail: image,
    title_origin: string,
    composer_origin: string,
    snippet_before: string,
    snippet_match: string,
    snippet_after: string,
}

export struct SectionItem {
    key: string,
    label: string,
    count: int,
    kind: string,
}

export component PagePreview inherits Rectangle {
    in property <LibraryRow> score;
    border-radius: 14px;
    background: Theme.paper;
    border-width: 1px;
    border-color: Theme.paper-edge;
    clip: true;
    if root.score.has_thumbnail : Image {
        width: parent.width;
        height: parent.height;
        source: root.score.thumbnail;
        image-fit: contain;
        accessible-role: none;
    }
    if !root.score.has_thumbnail : Glyph {
        kind: "document";
        width: min(40px, parent.width / 2);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// A 48 px action on a card or row. The round backing keeps the icon readable over a page thumbnail.
component ItemAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.divider;
    IconButton {
        x: 0px;
        y: 0px;
        label: root.label;
        icon: root.icon;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Touch target of a card or row. A tap (or Enter/Space) emits `activated`; holding for 500 ms
// without moving beyond touch slop emits `long-pressed` instead, and that press never also
// activates. Releasing early, scrolling away, a modal opening or the item disappearing cancel it.
component ItemInput inherits ActionInput {
    callback activated();
    callback long-pressed();
    private property <bool> holding: false;
    private property <bool> consumed: false;
    changed pressed => {
        if self.pressed {
            self.consumed = false;
            self.holding = true;
        } else {
            self.holding = false;
        }
    }
    changed enabled => { if !self.enabled { self.holding = false; } }
    moved => {
        if self.holding && (abs(self.mouse-x - self.pressed-x) > 10px || abs(self.mouse-y - self.pressed-y) > 10px) {
            self.holding = false;
        }
    }
    clicked => {
        if self.consumed {
            self.consumed = false;
        } else {
            self.focus();
            self.activated();
        }
    }
    Timer {
        interval: 500ms;
        running: root.holding && root.enabled;
        triggered => {
            root.holding = false;
            root.consumed = true;
            root.long-pressed();
        }
    }
}

component ScoreCard inherits Rectangle {
    in property <LibraryRow> score;
    // Tapping opens the PDF itself (Recent); otherwise it opens the preview.
    in property <bool> direct-open;
    // False while the actions menu is open, so nothing beneath it reacts.
    in property <bool> interactive: true;
    callback select();
    callback open();
    callback edit();
    callback long-pressed();
    border-radius: 20px;
    background: input.pressed ? Theme.field : transparent;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.score.title;
    accessible-description: root.score.composer_or_artist + (root.score.text_pending ? ". Text unavailable. Run desktop OCR or import a sidecar." : "") + (root.direct-open ? ". Opens the score" : "");
    accessible-action-default => { if root.interactive && !Theme.modal-open { root.activate(); } }
    forward-focus: input;
    function activate() {
        if root.direct-open { root.open(); } else { root.select(); }
    }
    input := ItemInput {
        enabled: root.interactive && !Theme.modal-open;
        activated => { root.activate(); }
        long-pressed => { root.long-pressed(); }
    }
    VerticalLayout {
        padding: 6px;
        spacing: 10px;
        Rectangle {
            vertical-stretch: 1;
            PagePreview { score: root.score; width: parent.width; height: parent.height; }
            if root.score.text_pending : StatusBadge { text: "No text yet"; x: 8px; y: parent.height - self.height - 8px; }
        }
        VerticalLayout {
            spacing: 2px;
            padding-left: 4px;
            padding-right: 4px;
            Text { text: root.score.title; color: Theme.foreground; font-size: 16px; font-weight: 600; overflow: elide; }
            Text {
                text: (root.score.id != "" && root.score.composer_or_artist != "" ? root.score.id + " · " + root.score.composer_or_artist : root.score.id + root.score.composer_or_artist);
                color: Theme.muted;
                font-size: 14px;
                overflow: elide;
            }
        }
    }
    ItemAction {
        label: "Edit details";
        icon: @image-url("material-icons/edit.svg");
        enabled: root.interactive;
        x: root.width - self.width - 12px;
        y: 12px;
        clicked => { root.edit(); }
    }
    if root.direct-open : ItemAction {
        label: "Score details";
        icon: @image-url("material-icons/info.svg");
        enabled: root.interactive;
        x: root.width - 2 * self.width - 18px;
        y: 12px;
        clicked => { root.select(); }
    }
}

component ScoreGrid inherits Flickable {
    in property <[LibraryRow]> rows;
    in property <bool> direct-open;
    in property <bool> items-enabled: true;
    callback select(string);
    callback open(string, string);
    callback edit(string);
    callback long-pressed(LibraryRow);
    private property <int> columns: max(1, floor((self.width + 16px) / 192px));
    private property <length> cell-width: (self.width - (self.columns - 1) * 16px) / self.columns;
    private property <length> cell-height: self.cell-width * 1.3 + 64px;
    content-height: ceil(root.rows.length / root.columns) * (self.cell-height + 20px);
    for row[index] in root.rows : ScoreCard {
        x: mod(index, root.columns) * (root.cell-width + 16px);
        y: floor(index / root.columns) * (root.cell-height + 20px);
        width: root.cell-width;
        height: root.cell-height;
        score: row;
        direct-open: root.direct-open;
        interactive: root.items-enabled;
        select => { root.select(row.note_key); }
        open => { root.open(row.relative_path, row.note_key); }
        edit => { root.edit(row.note_key); }
        long-pressed => { root.long-pressed(row); }
    }
}

// Dense alternative to ScoreCard. Fixed height keeps ListView virtualization exact.
export component ScoreRow inherits Rectangle {
    in property <LibraryRow> score;
    in property <bool> direct-open;
    in property <bool> interactive: true;
    callback select();
    callback open();
    callback edit();
    callback long-pressed();
    height: 80px;
    border-radius: 18px;
    background: input.pressed ? Theme.field : transparent;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.score.title;
    accessible-description: root.score.composer_or_artist + (root.score.text_pending ? ". Text pending" : "") + (root.direct-open ? ". Opens the score" : "");
    accessible-action-default => { if root.interactive && !Theme.modal-open { root.activate(); } }
    forward-focus: input;
    function activate() {
        if root.direct-open { root.open(); } else { root.select(); }
    }
    input := ItemInput {
        enabled: root.interactive && !Theme.modal-open;
        activated => { root.activate(); }
        long-pressed => { root.long-pressed(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 14px;
        VerticalLayout { alignment: center; PagePreview { score: root.score; width: 44px; height: 58px; border-radius: 6px; } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.score.title; font-size: 16px; font-weight: 600; overflow: elide; color: Theme.foreground; }
            Text {
                text: (root.score.id != "" && root.score.composer_or_artist != "" ? root.score.id + " · " + root.score.composer_or_artist : root.score.id + root.score.composer_or_artist);
                font-size: 14px;
                overflow: elide;
                color: Theme.muted;
            }
            if root.score.tags != "" : Text { text: root.score.tags; font-size: 13px; overflow: elide; color: Theme.muted; }
        }
        if root.score.text_pending : VerticalLayout { alignment: center; StatusBadge { text: "Text pending"; } }
        if root.direct-open : VerticalLayout {
            alignment: center;
            ItemAction {
                label: "Score details";
                icon: @image-url("material-icons/info.svg");
                enabled: root.interactive;
                clicked => { root.select(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ItemAction {
                label: "Edit details";
                icon: @image-url("material-icons/edit.svg");
                enabled: root.interactive;
                clicked => { root.edit(); }
            }
        }
    }
}

component SidePanel inherits VerticalLayout {
    in property <[SectionItem]> sections;
    in property <[SectionItem]> composers;
    in property <string> selected-key;
    callback section-selected(string);
    callback settings-clicked();
    spacing: 16px;
    HorizontalLayout {
        height: 64px;
        padding-left: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Image { source: @image-url("assets/notae.png"); image-fit: contain; width: 40px; height: 40px; } }
        Text { text: "Notae"; font-size: 22px; font-weight: 700; color: Theme.foreground; vertical-alignment: center; }
    }
    Card {
        VerticalLayout {
            padding: 8px;
            for item in root.sections : NavRow {
                label: item.label;
                kind: item.kind;
                count: item.count;
                selected: item.key == root.selected-key;
                clicked => { root.section-selected(item.key); }
            }
        }
    }
    if root.composers.length > 0 : Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 8px;
            HorizontalLayout { padding-left: 14px; Text { text: "Composers"; color: Theme.muted; font-size: 13px; font-weight: 600; height: 36px; vertical-alignment: center; } }
            ListView {
                for item in root.composers : NavRow {
                    label: item.label;
                    count: item.count;
                    selected: item.key == root.selected-key;
                    clicked => { root.section-selected(item.key); }
                }
            }
        }
    }
    if root.composers.length == 0 : Rectangle { vertical-stretch: 1; }
    NavRow { label: "Settings"; kind: "settings"; clicked => { root.settings-clicked(); } }
}

export component OperationBanner inherits Card {
    in property <string> text;
    in property <bool> busy;
    in property <bool> failed;
    in property <float> fraction;
    in property <bool> cancel-enabled;
    in property <bool> acknowledge-enabled;
    callback cancel();
    callback acknowledge();
    VerticalLayout {
        padding: 16px;
        padding-left: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout { alignment: center; Glyph { kind: root.busy ? "scan" : root.failed ? "warning" : "check"; ink: root.failed ? Theme.error : Theme.muted; } }
            Text { text: root.text; color: root.failed ? Theme.error : Theme.foreground; font-size: 15px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            if root.cancel-enabled : PillButton { text: "Cancel"; tonal: true; clicked => { root.cancel(); } }
            if root.acknowledge-enabled : PillButton { text: "Dismiss"; tonal: true; clicked => { root.acknowledge(); } }
        }
        if root.busy : Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.field;
            clip: true;
            accessible-role: progress-indicator;
            accessible-label: root.text;
            accessible-value: root.fraction > 0 ? root.fraction : "";
            accessible-value-minimum: 0;
            accessible-value-maximum: 1;
            Rectangle {
                width: parent.width * (root.fraction > 0 ? root.fraction : 0.3);
                x: 0px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
}

export component LibraryScreen inherits Rectangle {
    in property <length> available-width;
    in property <bool> expanded;
    // The 288 px side panel is shown only when the window is wide enough and the user has not collapsed it.
    in property <bool> sidebar-visible;
    in property <bool> list-view;
    in property <[SectionItem]> sections;
    in property <[SectionItem]> composers;
    in property <string> selected-section;
    in property <string> title;
    in property <string> subtitle;
    in property <[LibraryRow]> rows;
    in property <string> pdf-error;
    in property <string> progress-text;
    in property <bool> busy;
    in property <float> fraction;
    in property <bool> cancel-enabled;
    in property <bool> acknowledge-enabled;
    in property <bool> failed;
    in property <bool> rescan-enabled;
    // Recent opens the PDF on tap; its Score details action opens the preview.
    private property <bool> direct-open: root.selected-section == "recent";
    // Long-press actions menu. The owner binds `menu-open` so Back/Escape can dismiss it.
    in-out property <bool> menu-open: false;
    private property <LibraryRow> menu-row;
    function show-menu(row: LibraryRow) {
        root.menu-row = row;
        root.menu-open = true;
    }
    init => { root.menu-open = false; }
    callback rescan-clicked();
    callback sidebar-toggle-clicked();
    callback view-toggle-clicked();
    pure function empty-title(key: string) -> string {
        return key == "all" ? "A little space for your scores"
            : key == "recent" ? "No recent scores"
            : key == "needs-details" ? "Nothing needs details"
            : key == "text-pending" ? "No text pending"
            : "No scores here";
    }
    pure function empty-detail(key: string) -> string {
        return key == "all" ? "Scan your library folder to add the PDFs it contains."
            : key == "recent" ? "Scores you open appear here."
            : key == "needs-details" ? "Scores missing a number or composer appear here."
            : key == "text-pending" ? "Scores without searchable text appear here until desktop OCR or a sidecar import provides it."
            : "No scores by this composer are in the library.";
    }
    callback section-selected(string);
    callback settings-clicked();
    callback search-clicked();
    callback cancel-clicked();
    callback acknowledge-clicked();
    callback score-selected(string);
    callback score-opened(string, string);
    callback edit-requested(string);
    // When true, the full-width preview (passed as children) replaces the whole library chrome.
    in property <bool> details-open;
    background: Theme.background;

    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        if root.sidebar-visible && !root.details-open : SidePanel {
            width: 288px;
            sections: root.sections;
            composers: root.composers;
            selected-key: root.selected-section;
            section-selected(key) => { root.section-selected(key); }
            settings-clicked => { root.settings-clicked(); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            if !root.details-open : HorizontalLayout {
                padding-top: 8px;
                padding-left: 8px;
                spacing: 4px;
                if root.expanded : VerticalLayout {
                    alignment: center;
                    IconButton {
                        label: root.sidebar-visible ? "Hide sidebar" : "Show sidebar";
                        icon: root.sidebar-visible ? @image-url("material-icons/panel-left-close.svg") : @image-url("material-icons/panel-left-open.svg");
                        clicked => { root.sidebar-toggle-clicked(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.title; color: Theme.foreground; font-size: root.expanded ? 40px : root.available-width < 420px ? 24px : 30px; font-weight: 600; overflow: elide; }
                    Text { text: root.subtitle; color: Theme.muted; font-size: 15px; }
                }
                // Header actions: Search, layout toggle, Settings (when the side panel is not showing), Scan. Scan is always right-most.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        IconButton { label: "Search"; icon: @image-url("material-icons/search.svg"); clicked => { root.search-clicked(); } }
                        IconButton {
                            label: root.list-view ? "Switch to grid view" : "Switch to list view";
                            icon: root.list-view ? @image-url("material-icons/layout-grid.svg") : @image-url("material-icons/layout-list.svg");
                            clicked => { root.view-toggle-clicked(); }
                        }
                        if !root.sidebar-visible : IconButton { label: "Settings"; icon: @image-url("material-icons/settings.svg"); clicked => { root.settings-clicked(); } }
                        ScanButton { enabled: root.rescan-enabled; clicked => { root.rescan-clicked(); } }
                    }
                }
            }
            if !root.sidebar-visible && !root.details-open : Flickable {
                min-height: 48px; max-height: 48px;
                // A Flickable reports its viewport width as its maximum, which would cap the whole column.
                max-width: 100000px;
                interactive: self.content-width > self.width;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                    spacing: 8px;
                    for item in root.sections : Chip {
                        label: item.label;
                        selected: item.key == root.selected-section;
                        clicked => { root.section-selected(item.key); }
                    }
                    for item in root.composers : Chip {
                        label: item.label;
                        selected: item.key == root.selected-section;
                        clicked => { root.section-selected(item.key); }
                    }
                }
            }
            if root.progress-text != "" : OperationBanner {
                vertical-stretch: 0;
                text: root.progress-text;
                busy: root.busy;
                failed: root.failed;
                fraction: root.fraction;
                cancel-enabled: root.cancel-enabled;
                acknowledge-enabled: root.acknowledge-enabled;
                cancel => { root.cancel-clicked(); }
                acknowledge => { root.acknowledge-clicked(); }
            }
            if root.pdf-error != "" : Text { text: root.pdf-error; color: Theme.error; font-size: 15px; wrap: word-wrap; }
            // The preview (passed as children) replaces the grid. Slint does not allow
            // @children inside a conditional element, so the slot is always present and hidden.
            Rectangle {
                vertical-stretch: 1;
                if !root.details-open && root.rows.length > 0 && !root.list-view : Card {
                    width: parent.width;
                    height: parent.height;
                    ScoreGrid {
                        x: 20px;
                        y: 20px;
                        width: parent.width - 40px;
                        height: parent.height - 20px;
                        rows: root.rows;
                        direct-open: root.direct-open;
                        items-enabled: !root.menu-open;
                        select(key) => { root.score-selected(key); }
                        open(path, key) => { root.score-opened(path, key); }
                        edit(key) => { root.edit-requested(key); }
                        long-pressed(row) => { root.show-menu(row); }
                    }
                }
                if !root.details-open && root.rows.length > 0 && root.list-view : Card {
                    width: parent.width;
                    height: parent.height;
                    ListView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        for row in root.rows : ScoreRow {
                            score: row;
                            direct-open: root.direct-open;
                            interactive: !root.menu-open;
                            select => { root.score-selected(row.note_key); }
                            open => { root.score-opened(row.relative_path, row.note_key); }
                            edit => { root.edit-requested(row.note_key); }
                            long-pressed => { root.show-menu(row); }
                        }
                    }
                }
                if !root.details-open && root.rows.length == 0 : Card {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        alignment: center;
                        padding: 32px;
                        spacing: 12px;
                        HorizontalLayout { alignment: center; Glyph { kind: "folder"; width: 56px; height: 56px; } }
                        Text {
                            text: root.empty-title(root.selected-section);
                            color: Theme.foreground; font-size: 22px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap;
                        }
                        Text {
                            text: root.empty-detail(root.selected-section);
                            color: Theme.muted; font-size: 15px; horizontal-alignment: center; wrap: word-wrap;
                        }
                        if root.selected-section == "all" : HorizontalLayout {
                            alignment: center;
                            padding-top: 8px;
                            PillButton {
                                text: "Scan library";
                                icon: @image-url("material-icons/scan.svg");
                                primary: true;
                                enabled: root.rescan-enabled;
                                clicked => { root.rescan-clicked(); }
                            }
                        }
                    }
                }
                Rectangle {
                    visible: root.details-open;
                    width: parent.width;
                    height: parent.height;
                    @children
                }
            }
        }
    }

    // Actions for a long-pressed score. The scrim swallows pointer input, so dismissing the menu
    // never activates the item underneath.
    if root.menu-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {
            mouse-cursor: default;
            accessible-role: none;
            clicked => { root.menu-open = false; }
        }
        menu-card := Rectangle {
            width: min(340px, root.width - 32px);
            height: menu-content.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.card;
            border-radius: 26px;
            init => { menu-open-action.focus(); }
            accessible-role: form;
            accessible-label: "Actions for " + root.menu-row.title;
            TouchArea { accessible-role: none; }
            menu-content := VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: root.menu-row.title; color: Theme.foreground; font-size: 18px; font-weight: 600; overflow: elide; }
                menu-open-action := PillButton {
                    in-dialog: true;
                    text: "Open score";
                    primary: true;
                    clicked => { root.menu-open = false; root.score-opened(root.menu-row.relative_path, root.menu-row.note_key); }
                }
                PillButton {
                    in-dialog: true;
                    text: "Score details";
                    tonal: true;
                    clicked => { root.menu-open = false; root.score-selected(root.menu-row.note_key); }
                }
                PillButton {
                    in-dialog: true;
                    text: "Edit details";
                    tonal: true;
                    clicked => { root.menu-open = false; root.edit-requested(root.menu-row.note_key); }
                }
            }
        }
    }
}
