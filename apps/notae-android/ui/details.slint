// Full-width score preview: one score at a time, with previous/next browsing.
import { ScrollView } from "std-widgets.slint";
import { Theme, IconButton, PillButton, Card } from "components.slint";
import { LibraryRow, PagePreview } from "library.slint";
import { Scrollbar } from "scrollbar.slint";

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> origin;
    min-height: 60px;
    spacing: 16px;
    Text { text: root.label; width: 96px; color: Theme.muted; font-size: 15px; vertical-alignment: center; }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        Text { text: root.value == "" ? "—" : root.value; color: Theme.foreground; font-size: 16px; wrap: word-wrap; }
        if root.origin != "" : Text { text: root.origin; color: Theme.muted; font-size: 13px; }
    }
}

component InfoCard inherits Rectangle {
    in property <LibraryRow> score;
    border-radius: 20px;
    background: Theme.background;
    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 4px;
        padding-bottom: 4px;
        InfoRow { label: "Title"; value: root.score.title; origin: root.score.title_origin; }
        Rectangle { height: 1px; background: Theme.divider; }
        InfoRow { label: "Composer"; value: root.score.composer_or_artist; origin: root.score.composer_origin; }
        Rectangle { height: 1px; background: Theme.divider; }
        InfoRow { label: "Tags"; value: root.score.tags; origin: ""; }
        Rectangle { height: 1px; background: Theme.divider; }
        InfoRow { label: "File"; value: root.score.relative_path; origin: root.score.status; }
    }
}

// Title, composer and the Open/Edit actions; shared by the wide and stacked layouts.
component ScoreHeadline inherits VerticalLayout {
    in property <LibraryRow> score;
    in property <bool> centered;
    callback open();
    callback edit();
    spacing: 6px;
    alignment: start;
    if root.score.id != "" : Text { text: "No. " + root.score.id; color: Theme.accent-text; font-size: 14px; font-weight: 600; horizontal-alignment: root.centered ? center : left; }
    Text { text: root.score.title; color: Theme.foreground; font-size: root.centered ? 26px : 32px; font-weight: 600; wrap: word-wrap; horizontal-alignment: root.centered ? center : left; }
    if root.score.composer_or_artist != "" : Text { text: root.score.composer_or_artist; color: Theme.muted; font-size: 17px; wrap: word-wrap; horizontal-alignment: root.centered ? center : left; }
    HorizontalLayout {
        padding-top: 18px;
        spacing: 10px;
        alignment: root.centered ? center : start;
        PillButton { text: "Open score"; primary: true; clicked => { root.open(); } }
        IconButton { label: "Edit details"; icon: @image-url("material-icons/edit.svg"); clicked => { root.edit(); } }
    }
}

export component ScoreDetails inherits Card {
    in property <LibraryRow> score;
    // "3 of 12" in the current section; empty when the score is not in it.
    in property <string> position;
    in property <bool> has-previous;
    in property <bool> has-next;
    callback close();
    callback open();
    callback edit();
    callback previous();
    callback next();
    // Derived from this pane's own size (assigned by its parent), never from its children.
    private property <bool> wide: root.width >= 720px;
    private property <length> preview-width: root.wide
        ? max(160px, min(380px, root.width * 0.4, (root.height - 112px) / 1.3))
        : max(140px, min(300px, root.width - 64px));
    VerticalLayout {
        padding: 8px;
        HorizontalLayout {
            spacing: 4px;
            IconButton {
                label: "Back to library";
                icon: @image-url("material-icons/arrow-back.svg");
                clicked => { root.close(); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.position;
                color: Theme.muted;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: root.position == "" ? "" : "Score " + root.position;
            }
            IconButton {
                label: "Previous score";
                icon: @image-url("material-icons/chevron-left.svg");
                enabled: root.has-previous;
                clicked => { root.previous(); }
            }
            IconButton {
                label: "Next score";
                icon: @image-url("material-icons/chevron-right.svg");
                enabled: root.has-next;
                clicked => { root.next(); }
            }
        }
        // The pane can be shorter than its content (landscape phones, split screen), so the body scrolls.
        Rectangle {
            vertical-stretch: 1;
            body := ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    width: root.width - 16px;
                    padding-bottom: 24px;
                    spacing: 24px;
                    if root.wide : HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 32px;
                        alignment: center;
                        PagePreview { score: root.score; width: root.preview-width; height: root.preview-width * 1.3; border-radius: 16px; }
                        VerticalLayout {
                            // Reading width: the metadata stays beside the page instead of stretching across a tablet.
                            horizontal-stretch: 1;
                            min-width: 320px;
                            preferred-width: 560px;
                            max-width: 640px;
                            spacing: 24px;
                            ScoreHeadline {
                                score: root.score;
                                open => { root.open(); }
                                edit => { root.edit(); }
                            }
                            InfoCard { score: root.score; }
                        }
                    }
                    if !root.wide : VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 20px;
                        HorizontalLayout { alignment: center; PagePreview { score: root.score; width: root.preview-width; height: root.preview-width * 1.3; border-radius: 16px; } }
                        ScoreHeadline {
                            centered: true;
                            score: root.score;
                            open => { root.open(); }
                            edit => { root.edit(); }
                        }
                        InfoCard { score: root.score; }
                    }
                }
            }
            Scrollbar {
                x: parent.width - self.width;
                y: 0px;
                width: 48px;
                height: parent.height;
                content-height: body.content-height;
                visible-height: body.visible-height;
                content-y: body.content-y;
                scrolled(y) => { body.content-y = y; }
            }
        }
    }
}
