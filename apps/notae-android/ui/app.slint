// Notae — task 2 Slint shell.
//
// The layout shows one of three screens, chosen by the storage state:
//
//   * `setup_screen`      — fresh install / no library root chosen.
//   * `recovery_screen`   — library root was selected once but the
//                            persisted permission was revoked.
//   * `library_screen`    — a library root is selected and open.
//
// Each screen has a single primary action whose callback the host code
// wires to the `LibraryRootProvider`. The setup and recovery screens
// share the same `accepted` callback name (`setup_chosen`) so a single
// Slint callback on `AppWindow` is enough to drive both flows — the
// Rust side decides which action to take based on the storage state.

import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct LibraryRow {
    id: string,
    title: string,
    composer_or_artist: string,
    tags: string,
    status: string,
    note_key: string,
    relative_path: string,
}

export struct ImportRow {
    path: string,
    change: string,
    local_metadata: string,
    proposed_metadata: string,
    fields: string,
    ocr: string,
    conflict: string,
}

component SetupScreen inherits Rectangle {
    background: #1e1e1e;

    in-out property <string> error_text: "";

    callback accepted();

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Notae";
            font-size: 32px;
            horizontal-alignment: center;
            color: #ffffff;
        }

        Text {
            text: "Pick a library folder to begin.";
            horizontal-alignment: center;
            color: #cccccc;
            wrap: word-wrap;
        }

        // Visible only when the storage state is `Error`. An empty
        // string hides the label so the layout collapses back to the
        // fresh-install flow.
        if root.error_text != "" : Text {
            text: root.error_text;
            horizontal-alignment: center;
            color: #ff8888;
            wrap: word-wrap;
        }

        Button {
            text: "Select folder";
            primary: true;
            min-height: 48px;
            clicked => { root.accepted(); }
        }
    }
}

component RecoveryScreen inherits Rectangle {
    background: #1e1e1e;

    in-out property <string> folder_name: "this folder";

    callback accepted();

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Permission lost";
            font-size: 28px;
            horizontal-alignment: center;
            color: #ffffff;
        }

        Text {
            text: "Access to '" + root.folder_name + "' was revoked. Reauthorize to continue indexing it.";
            horizontal-alignment: center;
            color: #cccccc;
            wrap: word-wrap;
        }

        Button {
            text: "Reauthorize folder";
            primary: true;
            min-height: 48px;
            clicked => { root.accepted(); }
        }
    }
}

component LibraryResultRow inherits Rectangle {
    in property <LibraryRow> note;
    callback edit_requested(string);
    callback open_requested(string);
    background: #292929;
    width: 100%;
    height: 128px;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.note.id == "" ? root.note.title : root.note.id + " · " + root.note.title;
                    font-size: 20px;
                    color: #ffffff;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.note.status;
                    color: #dddddd;
                    vertical-alignment: center;
                }
            }
            if root.note.composer_or_artist != "" : Text {
                text: root.note.composer_or_artist;
                font-size: 16px;
                color: #cccccc;
            }
            if root.note.tags != "" : Text {
                text: root.note.tags;
                font-size: 14px;
                color: #aaaaaa;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Open";
                min-height: 48px;
                clicked => { root.open_requested(root.note.relative_path); }
            }
            Button {
                text: "Edit";
                min-height: 48px;
                clicked => { root.edit_requested(root.note.note_key); }
            }
        }
    }
}

component LibraryScreen inherits Rectangle {
    in property <[LibraryRow]> rows: [];
    in property <string> search_text: "";
    callback edit_requested(string);
    callback open_requested(string);
    background: #1e1e1e;

    VerticalLayout {
        spacing: 8px;

        if root.rows.length == 0 : VerticalLayout {
            alignment: center;
            vertical-stretch: 1;
            Text {
                text: root.search_text == "" ? "No notes yet." : "No matching notes.";
                horizontal-alignment: center;
                color: #cccccc;
                font-size: 20px;
            }
            Text {
                text: root.search_text == "" ? "Tap Rescan to index this library." : "Try another search.";
                horizontal-alignment: center;
                color: #888888;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        if root.rows.length > 0 : ListView {
            width: 100%;
            vertical-stretch: 1;
            for item in root.rows : LibraryResultRow {
                note: item;
                edit_requested(key) => { root.edit_requested(key); }
                open_requested(path) => { root.open_requested(path); }
            }
        }
    }
}

component MetadataEditorPanel inherits Rectangle {
    in-out property <string> note_key: "";
    in-out property <string> note_id: "";
    in-out property <string> title: "";
    in-out property <string> composer_or_artist: "";
    in-out property <string> tags: "";
    in property <string> error_text: "";
    callback save_requested(string, string, string, string, string);
    callback cancel_requested();
    background: #303030;
    height: 380px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: "Edit note metadata";
            font-size: 20px;
            color: #ffffff;
        }
        LineEdit {
            placeholder-text: "Note ID (optional)";
            text: root.note_id;
            min-height: 48px;
            edited(value) => { root.note_id = value; }
        }
        LineEdit {
            placeholder-text: "Title";
            text: root.title;
            min-height: 48px;
            edited(value) => { root.title = value; }
        }
        LineEdit {
            placeholder-text: "Composer or artist (optional)";
            text: root.composer_or_artist;
            min-height: 48px;
            edited(value) => { root.composer_or_artist = value; }
        }
        LineEdit {
            placeholder-text: "Tags, separated by commas";
            text: root.tags;
            min-height: 48px;
            edited(value) => { root.tags = value; }
        }
        if root.error_text != "" : Text {
            text: root.error_text;
            color: #ff8888;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Save";
                primary: true;
                min-height: 48px;
                clicked => {
                    root.save_requested(root.note_key, root.note_id, root.title, root.composer_or_artist, root.tags);
                }
            }
            Button {
                text: "Cancel";
                min-height: 48px;
                clicked => { root.cancel_requested(); }
            }
        }
    }
}

component ImportPreviewListRow inherits Rectangle {
    in property <ImportRow> item;
    background: #252525;
    height: 112px;

    VerticalLayout {
        padding: 8px;
        spacing: 3px;
        Text {
            text: root.item.path + " · " + root.item.change;
            color: #ffffff;
            font-size: 16px;
        }
        Text {
            text: "Local: " + root.item.local_metadata;
            color: #bbbbbb;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: "PC: " + root.item.proposed_metadata;
            color: #bbbbbb;
            font-size: 13px;
            wrap: word-wrap;
        }
        Text {
            text: root.item.fields + root.item.ocr + root.item.conflict;
            color: #aaaaaa;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

component SettingsScreen inherits Rectangle {
    callback closed();
    background: #1e1e1e;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;
        Text {
            text: "Settings";
            font-size: 28px;
            color: #ffffff;
            horizontal-alignment: center;
        }
        Button {
            text: "Back to library";
            min-height: 48px;
            clicked => { root.closed(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Notae";
    background: #1e1e1e;

    // Rust writes screen and result state; the Slint side updates the
    // search text in response to user input.
    in-out property <bool> show_setup: true;
    in-out property <bool> show_recovery: false;
    in-out property <string> recovery_folder_name: "";
    in-out property <string> setup_error_text: "";
    in-out property <bool> rescan_enabled: false;
    in property <bool> acknowledge_enabled: false;
    in property <bool> show_settings: false;
    in property <[LibraryRow]> library_rows: [];
    in property <[ImportRow]> import_rows: [];
    in-out property <string> search_text: "";
    in property <string> operation_progress_text: "";
    in property <bool> cancel_enabled: false;
    in property <bool> show_import_preview: false;
    in property <string> import_preview_text: "";
    in property <bool> show_metadata_editor: false;
    in-out property <string> metadata_note_key: "";
    in-out property <string> metadata_id: "";
    in-out property <string> metadata_title: "";
    in-out property <string> metadata_composer_or_artist: "";
    in-out property <string> metadata_tags: "";
    in property <string> metadata_error_text: "";
    in property <string> pdf_launch_error_text: "";
    callback settings_clicked();
    callback settings_closed();

    callback setup_chosen();
    callback rescan_clicked();
    callback cancel_rescan_clicked();
    callback acknowledge_clicked();
    callback import_confirmed();
    callback import_cancelled();
    callback search_changed(string);
    callback edit_metadata_requested(string);
    callback metadata_save_requested(string, string, string, string, string);
    callback metadata_cancelled();
    callback open_pdf_requested(string);

    VerticalLayout {
        spacing: 8px;
        padding: 12px;

        if !root.show_setup && !root.show_recovery && !root.show_settings : HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "Search notes";
                text: root.search_text;
                height: 56px;
                horizontal-stretch: 1;
                font-size: 20px;
                edited(text) => {
                    root.search_text = text;
                    root.search_changed(text);
                }
            }
            Button {
                text: "Rescan";
                enabled: root.rescan_enabled;
                min-height: 48px;
                clicked => { root.rescan_clicked(); }
            }
            if root.cancel_enabled : Button {
                text: "Cancel";
                min-height: 48px;
                clicked => { root.cancel_rescan_clicked(); }
            }
            if root.acknowledge_enabled : Button {
                text: "Done";
                min-height: 48px;
                clicked => { root.acknowledge_clicked(); }
            }
            Button {
                text: "Settings";
                min-height: 48px;
                clicked => { root.settings_clicked(); }
            }
        }

        if root.operation_progress_text != "" && !root.show_settings : Text {
            text: root.operation_progress_text;
            color: #cccccc;
            font-size: 16px;
            horizontal-alignment: center;
        }

        if root.pdf_launch_error_text != "" && !root.show_settings : Text {
            text: root.pdf_launch_error_text;
            color: #ff8888;
            font-size: 16px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.show_import_preview && !root.show_settings : Rectangle {
            background: #303030;
            height: 300px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "PC sidecar import preview";
                    font-size: 20px;
                    color: #ffffff;
                }
                Text {
                    text: root.import_preview_text;
                    wrap: word-wrap;
                    color: #cccccc;
                    font-size: 13px;
                }
                ListView {
                    vertical-stretch: 1;
                    for item in root.import_rows : ImportPreviewListRow {
                        item: item;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Apply import";
                        primary: true;
                        min-height: 48px;
                        clicked => { root.import_confirmed(); }
                    }
                    Button {
                        text: "Keep local";
                        min-height: 48px;
                        clicked => { root.import_cancelled(); }
                    }
                }
            }
        }

        if root.show_setup : SetupScreen {
            error_text: root.setup_error_text;
            accepted() => { root.setup_chosen(); }
        }

        if root.show_recovery : RecoveryScreen {
            folder_name: root.recovery_folder_name;
            accepted() => { root.setup_chosen(); }
        }

        if root.show_settings : SettingsScreen {
            vertical-stretch: 1;
            closed() => { root.settings_closed(); }
        }

        if !root.show_setup && !root.show_recovery && !root.show_settings : LibraryScreen {
            vertical-stretch: 1;
            rows: root.library_rows;
            search_text: root.search_text;
            edit_requested(note_key) => { root.edit_metadata_requested(note_key); }
            open_requested(path) => { root.open_pdf_requested(path); }
        }

        if root.show_metadata_editor && !root.show_settings : MetadataEditorPanel {
            note_key: root.metadata_note_key;
            note_id: root.metadata_id;
            title: root.metadata_title;
            composer_or_artist: root.metadata_composer_or_artist;
            tags: root.metadata_tags;
            error_text: root.metadata_error_text;
            save_requested(key, id, title, composer, tags) => {
                root.metadata_save_requested(key, id, title, composer, tags);
            }
            cancel_requested() => { root.metadata_cancelled(); }
        }
    }
}