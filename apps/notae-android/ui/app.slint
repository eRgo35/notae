// Notae's adaptive score library. Rust remains authoritative for library operations.
import { ListView, ScrollView } from "std-widgets.slint";
import { WelcomeScreen, SettingsScreen } from "setup.slint";
import { Theme, ScreenTransition, ViewPresence, PillButton, TextField, IconButton } from "components.slint";
import { LibraryScreen, LibraryRow, SectionItem, OperationBanner } from "library.slint";
import { SearchScreen } from "search.slint";
import { ScoreDetails } from "details.slint";
import { SetCard, SetDialog, DeleteSetDialog } from "sets.slint";
export { Theme, LibraryRow, SectionItem, SetCard }
export struct ImportRow {
    path: string,
    change: string,
    local_metadata: string,
    proposed_metadata: string,
    fields: string,
    ocr: string,
    conflict: string,
}

component Label inherits Text {
    color: Theme.foreground;
    font-size: 16px;
    vertical-alignment: center;
    overflow: elide;
}

component SupportingText inherits Label {
    color: Theme.muted;
    font-size: 14px;
}
component ImportCard inherits Rectangle {
    in property <ImportRow> item;
    background: Theme.background;
    border-radius: 20px;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Label { text: root.item.path; font-weight: 500; horizontal-stretch: 1; }
            SupportingText { text: root.item.change; color: Theme.accent-text; }
        }
        Text { text: @tr("On device: {}", root.item.local_metadata); color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        Rectangle { height: 1px; background: Theme.divider; }
        Text { text: @tr("From desktop: {}", root.item.proposed_metadata); color: Theme.foreground; font-size: 14px; wrap: word-wrap; }
        Text { text: root.item.fields + root.item.ocr; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
        if root.item.conflict != "" : Text { text: root.item.conflict; color: Theme.error; font-size: 14px; wrap: word-wrap; }
    }
}

// A `ListView` stacks its rows without spacing, so each row carries its own gap below the card.
component ImportEntry inherits Rectangle {
    in property <ImportRow> item;
    VerticalLayout {
        padding-bottom: 8px;
        ImportCard { item: root.item; }
    }
}

export component AppWindow inherits Window {
    title: "Notae";
    background: Theme.background;
    default-font-family: "sans-serif";
    default-font-size: 16px;
    min-width: 320px;
    min-height: 320px;
    preferred-width: 1280px;
    preferred-height: 800px;
    in-out property <bool> show_setup: true;
    in property <bool> startup-ready: false;
    in-out property <bool> show_recovery: false;
    in-out property <string> recovery_folder_name: "";
    in-out property <string> setup_error_text: "";
    in-out property <bool> rescan_enabled: false;
    in property <bool> acknowledge_enabled: false;
    in property <bool> show_settings: false;
    in property <[LibraryRow]> library_rows: [];
    in property <[ImportRow]> import_rows: [];
    in-out property <string> search_text: "";
    in property <bool> hardware_keyboard_present: false;
    in property <bool> voice_search_available: false;
    in property <string> operation_progress_text: "";
    in property <bool> cancel_enabled: false;
    in property <bool> operation_busy: false;
    in property <float> operation_fraction: -1;
    in property <bool> show_import_preview: false;
    in property <string> import_preview_text: "";
    in property <bool> show_metadata_editor: false;
    in-out property <string> metadata_note_key: "";
    in-out property <string> metadata_id: "";
    in-out property <string> metadata_title: "";
    in-out property <string> metadata_composer_or_artist: "";
    in-out property <string> metadata_tags: "";
    in property <string> metadata_error_text: "";
    in property <string> pdf_launch_error_text: "";
    in property <string> library_display_name: "";
    in property <string> settings_scan_summary: "No scan this session";
    in property <string> settings_scan_conflicts: "";
    in property <string> settings_scan_failures: "";
    in property <string> settings_indexed_count: "0";
    in property <string> settings_no_text_count: "0";
    in property <string> app_version: "";
    in property <string> app_build_identity: "unknown";
    in property <string> repository_url: "https://github.com/eRgo35/notae";
    in property <string> app_license: "MIT License";
    in property <string> sidecar_schema_version: "";
    in property <[SectionItem]> sections: [];
    in property <[SectionItem]> composers: [];
    in property <string> selected_section: "all";
    in property <string> library_title: "All scores";
    in property <string> library_subtitle: "";
    in property <string> library_notes: "";
    in property <LibraryRow> selected;
    // The previewed score's neighbours in the current section; empty at a boundary.
    in property <string> selected_previous_key: "";
    in property <string> selected_next_key: "";
    in property <string> selected_position: "";
    in property <bool> details_open: false;
    in property <bool> show_search: false;
    in property <string> search_scope: "everything";
    // Persisted by Rust (`UiPrefs`); toggled here so the layout reacts at once.
    in-out property <bool> library_menu_open: false;
    in-out property <bool> library_list_view: false;
    in-out property <bool> sidebar_collapsed_portrait: true;
    in-out property <bool> sidebar_collapsed_landscape: false;
    callback settings_clicked();
    callback settings_closed();
    callback language_chosen(int);
    in property <int> language_choice: 0;
    callback setup_chosen();
    callback rescan_clicked();
    callback cancel_rescan_clicked();
    callback acknowledge_clicked();
    callback import_confirmed();
    callback import_cancelled();
    callback search_changed(string);
    callback edit_metadata_requested(string);
    callback metadata_save_requested(string, string, string, string, string);
    callback metadata_cancelled();
    callback selection_cleared();
    callback open_pdf_requested(string, string);
    callback section_selected(string);
    callback search_opened();
    callback search_closed();
    callback search_scope_changed(string);
    callback search_result_chosen(string);
    callback voice_search_requested();
    callback library_view_changed(string);
    callback sidebar_collapsed_changed(bool, bool);
    callback score_selected(string);
    callback favorite_toggled(string);
    // Singing sets. The dialog's fields are owned here while it is open; Rust fills them on
    // open and reports validation errors through `set_dialog_error`.
    in property <[SetCard]> set_cards: [];
    in-out property <bool> show_set_dialog: false;
    in-out property <string> set_dialog_id: "";
    in-out property <string> set_dialog_name: "";
    in-out property <string> set_dialog_date: "";
    in-out property <string> set_dialog_notes: "";
    in-out property <string> set_dialog_error: "";
    // Non-empty while Rust waits for the user to confirm deleting the set with this name.
    in property <string> confirm_delete_set_name: "";
    callback new_set_requested();
    callback set_opened(string);
    callback edit_set_requested(string);
    callback delete_set_requested(string);
    callback delete_set_confirmed();
    callback delete_set_cancelled();
    callback set_dialog_saved(string, string, string, string);
    callback set_dialog_cancelled();
    in property <bool> operation_failed: false;
    in property <bool> animations-enabled: true;
    in property <bool> application-active: true;
    private property <bool> configured: !root.show_setup && !root.show_recovery;
    private property <bool> expanded: root.window-width >= 840px;
    // Portrait is a logical window taller than wide; each orientation keeps its own sidebar choice.
    private property <bool> portrait: root.height > root.width;
    private property <bool> sidebar-collapsed: root.portrait ? root.sidebar_collapsed_portrait : root.sidebar_collapsed_landscape;
    private property <bool> sidebar-visible: root.expanded && !root.sidebar-collapsed;
    // Widths are derived from the window, never from child layouts, so adaptive screens cannot loop.
    private property <length> window-width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
    private property <length> available-height: (root.virtual-keyboard-size.height > 0px ? root.virtual-keyboard-position.y : root.height - root.safe-area-insets.bottom) - root.safe-area-insets.top;
    private property <float> sheet-progress: root.show_metadata_editor || root.show_import_preview ? 1 : 0;
    animate sheet-progress { duration: Theme.motion-medium; easing: ease-in-out; }
    private property <float> sheet-visual-progress: Theme.animations-enabled
        ? root.sheet-progress : ((root.show_metadata_editor || root.show_import_preview) ? 1 : 0);
    private property <bool> set-modal-open: root.show_set_dialog || root.confirm_delete_set_name != "";
    private property <bool> modal-open: root.show_metadata_editor || root.show_import_preview || root.set-modal-open;
    set-dialog-presence := ViewPresence { active: root.show_set_dialog; }
    delete-set-presence := ViewPresence { active: root.confirm_delete_set_name != ""; }
    private property <bool> sheet-import-content: false;
    // One presence per top-level view: the logical destination is active at once, while a view
    // that was just left stays mounted (and blocked) until its exit has played.
    private property <bool> welcome-active: !root.configured && root.startup-ready;
    private property <bool> library-active: root.configured && root.startup-ready && !root.show_settings && !root.show_search;
    private property <bool> search-active: root.configured && root.startup-ready && root.show_search;
    private property <bool> settings-active: root.configured && root.startup-ready && root.show_settings;
    welcome-presence := ViewPresence { active: root.welcome-active; }
    library-presence := ViewPresence { active: root.library-active; }
    search-presence := ViewPresence { active: root.search-active; }
    settings-presence := ViewPresence { active: root.settings-active; }
    init => {
        Theme.animations-enabled = root.animations-enabled;
        Theme.modal-open = root.modal-open;
    }
    changed animations-enabled => { Theme.animations-enabled = root.animations-enabled; }
    changed modal-open => {
        Theme.modal-open = root.modal-open;
        if root.set-modal-open {
            // The set dialogs focus their own first control when they appear.
        } else if root.modal-open {
            root.sheet-import-content = root.show_import_preview;
            dialog-scope.focus();
        } else {
            shortcuts.focus();
        }
    }
    // Screens that unmount the focused control would otherwise leave Back/Escape unhandled.
    changed show_settings => { if !root.modal-open { shortcuts.focus(); } }
    changed show_search => { if !root.show_search && !root.modal-open { shortcuts.focus(); } }
    changed details_open => { if !root.modal-open { shortcuts.focus(); } }

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if root.modal-open || !root.configured { return reject; }
            if root.library_menu_open {
                if event.text == Key.Escape || event.text == Key.Back { root.library_menu_open = false; return accept; }
                return reject;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                if !root.show_search { root.search_opened(); }
                return accept;
            }
            if event.text == Key.Escape || event.text == Key.Back {
                if root.show_search { root.search_closed(); return accept; }
                if root.show_settings { root.settings_closed(); return accept; }
                if root.details_open { root.selection_cleared(); return accept; }
                // Inside a set, Back returns to the list of sets.
                if root.selected_section.starts-with("set:") { root.section_selected("sets"); return accept; }
            }
            if root.details_open && !root.show_search && !root.show_settings {
                if event.text == Key.LeftArrow && root.selected_previous_key != "" { root.score_selected(root.selected_previous_key); return accept; }
                if event.text == Key.RightArrow && root.selected_next_key != "" { root.score_selected(root.selected_next_key); return accept; }
            }
            return reject;
        }
    HorizontalLayout {
        // The viewport fills the window; adaptive children must not determine its intrinsic size.
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        spacing: 0px;
        // Views stack in one host instead of a layout, so a view that is leaving can stay mounted
        // beneath the one that is arriving. Every configured screen owns its header (including the
        // Scan action) and its own padding.
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            clip: true;
            if !root.startup-ready : Rectangle {
                background: Theme.background;
                width: parent.width;
                height: parent.height;
                Text {
                    text: @tr("Loading library…");
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: progress-indicator;
                    accessible-label: @tr("Loading library");
                }
            }
            if welcome-presence.mounted : ScreenTransition {
                presence: welcome-presence.value;
                active: root.welcome-active;
                direction: -1;
                width: parent.width;
                height: parent.height;
                WelcomeScreen {
                    x: root.expanded ? 28px : 16px;
                    y: root.expanded ? 28px : 16px;
                    width: parent.width - (root.expanded ? 56px : 32px);
                    height: parent.height - (root.expanded ? 56px : 32px);
                    available-width: root.window-width - (root.expanded ? 56px : 32px);
                    available-height: root.available-height;
                    recovery: root.show_recovery;
                    folder: root.recovery_folder_name;
                    error-text: root.setup_error_text;
                    accepted => { root.setup_chosen(); }
                }
            }
            if library-presence.mounted : ScreenTransition {
                presence: library-presence.value;
                active: root.library-active;
                direction: -1;
                width: parent.width;
                height: parent.height;
                LibraryScreen {
                    width: parent.width;
                    height: parent.height;
                available-width: root.window-width;
                vertical-stretch: 1;
                expanded: root.expanded;
                sidebar-visible: root.sidebar-visible;
                list-view: root.library_list_view;
                sidebar-toggle-clicked => {
                    if root.portrait {
                        root.sidebar_collapsed_portrait = !root.sidebar_collapsed_portrait;
                        root.sidebar_collapsed_changed(true, root.sidebar_collapsed_portrait);
                    } else {
                        root.sidebar_collapsed_landscape = !root.sidebar_collapsed_landscape;
                        root.sidebar_collapsed_changed(false, root.sidebar_collapsed_landscape);
                    }
                }
                view-toggle-clicked => {
                    root.library_list_view = !root.library_list_view;
                    root.library_view_changed(root.library_list_view ? "list" : "grid");
                }
                sections: root.sections;
                composers: root.composers;
                selected-section: root.selected_section;
                title: root.library_title;
                subtitle: root.library_subtitle;
                notes: root.library_notes;
                rows: root.library_rows;
                // A layout (not parent.width: `parent` here is LibraryScreen) fills the preview slot.
                VerticalLayout {
                    ScoreDetails {
                        score: root.selected;
                        position: root.selected_position;
                        has-previous: root.selected_previous_key != "";
                        has-next: root.selected_next_key != "";
                        close => { root.selection_cleared(); }
                        previous => { root.score_selected(root.selected_previous_key); }
                        next => { root.score_selected(root.selected_next_key); }
                        open => { root.open_pdf_requested(root.selected.relative_path, root.selected.note_key); }
                        edit => { root.edit_metadata_requested(root.selected.note_key); }
                        favorite-toggled => { root.favorite_toggled(root.selected.note_key); }
                    }
                }
                details-open: root.details_open;
                progress-text: root.operation_progress_text;
                busy: root.operation_busy;
                failed: root.operation_failed;
                fraction: root.operation_fraction;
                cancel-enabled: root.cancel_enabled;
                acknowledge-enabled: root.acknowledge_enabled;
                rescan-enabled: root.rescan_enabled;
                pdf-error: root.pdf_launch_error_text;
                section-selected(key) => { root.section_selected(key); }
                settings-clicked => { root.settings_clicked(); }
                search-clicked => { root.search_opened(); }
                rescan-clicked => { root.rescan_clicked(); }
                cancel-clicked => { root.cancel_rescan_clicked(); }
                acknowledge-clicked => { root.acknowledge_clicked(); }
                score-selected(key) => { root.score_selected(key); }
                score-opened(path, key) => { root.open_pdf_requested(path, key); }
                score-edit-requested(key) => { root.edit_metadata_requested(key); }
                favorite-toggled(key) => { root.favorite_toggled(key); }
                set-cards: root.set_cards;
                new-set-requested => { root.new_set_requested(); }
                set-opened(id) => { root.set_opened(id); }
                edit-set-requested(id) => { root.edit_set_requested(id); }
                delete-set-requested(id) => { root.delete_set_requested(id); }
                menu-open <=> root.library_menu_open;
            }
            }
            if search-presence.mounted : ScreenTransition {
                presence: search-presence.value;
                active: root.search-active;
                direction: 1;
                width: parent.width;
                height: parent.height;
                SearchScreen {
                    width: parent.width;
                    height: parent.height;
                    transition-finished: parent.finished;
                    application-active: root.application-active;
                available-width: root.window-width;
                vertical-stretch: 1;
                available-height: root.available-height;
                query: root.search_text;
                scope: root.search_scope;
                rows: root.library_rows;
                progress-text: root.operation_progress_text;
                busy: root.operation_busy;
                failed: root.operation_failed;
                fraction: root.operation_fraction;
                cancel-enabled: root.cancel_enabled;
                acknowledge-enabled: root.acknowledge_enabled;
                hardware-keyboard-present: root.hardware_keyboard_present;
                    init => { self.request-focus-after-layout(); }
                voice-available: root.voice_search_available;
                voice-requested => { root.voice_search_requested(); }
                cancel => { root.cancel_rescan_clicked(); }
                acknowledge => { root.acknowledge_clicked(); }
                query-edited(value) => { root.search_text = value; root.search_changed(value); }
                scope-changed(key) => { root.search_scope_changed(key); }
                close => { root.search_closed(); }
                chosen(key) => { root.search_result_chosen(key); }
            }
            }
            if settings-presence.mounted : ScreenTransition {
                presence: settings-presence.value;
                active: root.settings-active;
                direction: 1;
                width: parent.width;
                height: parent.height;
                SettingsScreen {
                    width: parent.width;
                    height: parent.height;
                available-width: root.window-width;
                vertical-stretch: 1;
                available-height: root.available-height;
                library-display-name: root.library_display_name;
                indexed-count: root.settings_indexed_count;
                no-text-count: root.settings_no_text_count;
                scan-summary: root.settings_scan_summary;
                scan-conflicts: root.settings_scan_conflicts;
                scan-failures: root.settings_scan_failures;
                version: root.app_version;
                build-identity: root.app_build_identity;
                repository: root.repository_url;
                license: root.app_license;
                schema-version: root.sidecar_schema_version;
                progress-text: root.operation_progress_text;
                busy: root.operation_busy;
                failed: root.operation_failed;
                fraction: root.operation_fraction;
                cancel-enabled: root.cancel_enabled;
                acknowledge-enabled: root.acknowledge_enabled;
                cancel => { root.cancel_rescan_clicked(); }
                acknowledge => { root.acknowledge_clicked(); }
                change-library => { root.setup_chosen(); }
                back => { root.settings_closed(); }
                language-choice: root.language_choice;
                language-chosen(choice) => { root.language_chosen(choice); }
            }
            }
        }
    }
    }

    // Modal sheets overlay rather than compressing the document list.
    Rectangle {
        x: 0px;
        y: 0px;
        visible: root.sheet-visual-progress > 0;
        width: parent.width;
        height: parent.height;
        background: #000000;
        opacity: root.sheet-visual-progress * 0.4;
        TouchArea { }
    }
    sheet := Rectangle {
        visible: root.sheet-visual-progress > 0;
        width: min(root.width - 32px, root.sheet-import-content ? 880px : 600px);
        height: min(max(0px, root.available-height - 32px), root.sheet-import-content ? 680px : 620px);
        x: (root.width - self.width) / 2;
        y: root.safe-area-insets.top + (root.available-height - self.height) / 2 + (1 - root.sheet-visual-progress) * 32px;
        opacity: root.sheet-visual-progress;
        background: Theme.card;
        border-radius: 26px;
        clip: true;
        accessible-role: form;
        accessible-label: root.sheet-import-content ? @tr("Review desktop import dialog") : @tr("Score details dialog");
        accessible-description: @tr("Modal dialog. Close or cancel to return to your library.");
        TouchArea { }
        dialog-scope := FocusScope {
            enabled: root.modal-open;
            forward-focus: dialog-close;
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Back {
                    if root.show_import_preview { root.import_cancelled(); } else { root.metadata_cancelled(); }
                    return accept;
                }
                return reject;
            }
        ScrollView {
        VerticalLayout {
            height: max(self.min-height, sheet.height);
            padding: root.expanded ? 28px : 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                Label { text: root.sheet-import-content ? @tr("Review desktop import") : @tr("Score details"); font-size: 24px; font-weight: 600; color: Theme.foreground; horizontal-stretch: 1; }
                dialog-close := IconButton {
                    in-dialog: true;
                    icon: @image-url("material-icons/close.svg");
                    clicked => { if root.sheet-import-content { root.import_cancelled(); } else { root.metadata_cancelled(); } }
                }
            }
            if root.sheet-import-content : VerticalLayout {
                spacing: 16px;
                Text { text: root.import_preview_text; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                ListView {
                    min-height: 120px;
                    vertical-stretch: 1;
                    for entry in root.import_rows : ImportEntry { item: entry; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    PillButton { in-dialog: true; text: @tr("Keep local"); clicked => { root.import_cancelled(); } }
                    PillButton { in-dialog: true; text: @tr("Apply import"); primary: true; clicked => { root.import_confirmed(); } }
                }
            }
            if !root.sheet-import-content : VerticalLayout {
                spacing: 16px;
                SupportingText { text: @tr("Update the details without renaming your PDF."); }
                VerticalLayout {
                    spacing: 16px;
                    // Each label sits closer to its own field than to the previous one.
                    VerticalLayout {
                        spacing: 6px;
                        Label { text: @tr("Title"); font-size: 14px; font-weight: 600; color: Theme.muted; }
                        TextField { in-dialog: true; text <=> root.metadata_title; placeholder: @tr("Score title"); }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Label { text: @tr("Composer or artist"); font-size: 14px; font-weight: 600; color: Theme.muted; }
                        TextField { in-dialog: true; text <=> root.metadata_composer_or_artist; placeholder: @tr("Composer or artist (optional)"); }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Label { text: @tr("Score number"); font-size: 14px; font-weight: 600; color: Theme.muted; }
                        TextField { in-dialog: true; text <=> root.metadata_id; placeholder: @tr("Score number (optional)"); }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Label { text: @tr("Tags"); font-size: 14px; font-weight: 600; color: Theme.muted; }
                        TextField { in-dialog: true; text <=> root.metadata_tags; placeholder: @tr("Tags, separated by commas"); }
                    }
                    if root.metadata_error_text != "" : Text { text: root.metadata_error_text; color: Theme.error; wrap: word-wrap; font-size: 14px; }
                    Rectangle { background: transparent; vertical-stretch: 1; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    PillButton { in-dialog: true; text: @tr("Cancel"); clicked => { root.metadata_cancelled(); } }
                    PillButton { in-dialog: true; text: @tr("Save details"); primary: true; clicked => { root.metadata_save_requested(root.metadata_note_key, root.metadata_id, root.metadata_title, root.metadata_composer_or_artist, root.metadata_tags); } }
                }
            }
        }
        }
        }
        if !root.modal-open : TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    if set-dialog-presence.mounted : SetDialog {
        x: 0px;
        y: root.safe-area-insets.top;
        width: root.width;
        height: root.available-height;
        presence: set-dialog-presence.value;
        set-id: root.set_dialog_id;
        name <=> root.set_dialog_name;
        date <=> root.set_dialog_date;
        notes <=> root.set_dialog_notes;
        error <=> root.set_dialog_error;
        saved(id, name, date, notes) => { root.set_dialog_saved(id, name, date, notes); }
        cancelled => { root.set_dialog_cancelled(); }
    }
    if delete-set-presence.mounted : DeleteSetDialog {
        x: 0px;
        y: root.safe-area-insets.top;
        width: root.width;
        height: root.available-height;
        presence: delete-set-presence.value;
        name: root.confirm_delete_set_name;
        confirmed => { root.delete_set_confirmed(); }
        cancelled => { root.delete_set_cancelled(); }
    }
}
