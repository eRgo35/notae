// Singing sets: folder cards (grid), set rows (list), the new/edit set dialog and the delete
// confirmation. Kept apart from library.slint, which places them.
import { ListView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, PillButton, Card, ActionInput, TextField } from "components.slint";
import { Scrollbar } from "scrollbar.slint";

export struct SetCard {
    id: string,
    name: string,
    date: string,
    count: string,
    edited: string,
}

// The ⋮ of a set, the way to Edit set and Delete set. A full 48 px target named after the set.
component SetActions inherits IconButton {
    in property <string> name;
    label: @tr("More actions for {}", root.name);
    icon: @image-url("material-icons/more-vertical.svg");
}

// A blank page leaning out of a folder, drawn like the score paper.
component FolderPage inherits Rectangle {
    border-radius: 10px;
    background: Theme.paper;
    border-width: 1px;
    border-color: Theme.paper-edge;
}

export component SetFolderCard inherits Rectangle {
    in property <SetCard> set;
    // False while the actions sheet is open, so nothing beneath it reacts.
    in property <bool> interactive: true;
    callback open();
    callback more();
    border-radius: 20px;
    background: input.pressed ? Theme.field : transparent;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.set.name;
    accessible-description: root.set.date + ". " + root.set.count + ". " + @tr("Opens the set");
    accessible-action-default => { if root.interactive && !Theme.modal-open { root.open(); } }
    forward-focus: input;
    input := ActionInput {
        enabled: root.interactive && !Theme.modal-open;
        clicked => {
            self.focus();
            root.open();
        }
    }
    VerticalLayout {
        padding: 6px;
        spacing: 10px;
        Rectangle {
            vertical-stretch: 1;
            border-radius: 18px;
            background: Theme.accent-soft;
            clip: true;
            FolderPage { x: parent.width * 0.2; y: 30px; width: parent.width * 0.46; height: parent.height; }
            FolderPage { x: parent.width * 0.34; y: 20px; width: parent.width * 0.46; height: parent.height; }
            Rectangle {
                x: 12px;
                y: parent.height - self.height - 12px;
                height: 28px;
                width: count-text.preferred-width + 24px;
                border-radius: 14px;
                background: Theme.card;
                count-text := Text { x: 12px; height: parent.height; vertical-alignment: center; text: root.set.count; color: Theme.foreground; font-size: 13px; font-weight: 600; accessible-role: none; }
            }
        }
        VerticalLayout {
            spacing: 2px;
            padding-left: 4px;
            // The overflow button sits over the end of this block.
            padding-right: 44px;
            Text { text: root.set.name; color: Theme.foreground; font-size: 16px; font-weight: 600; overflow: elide; accessible-role: none; }
            Text { text: root.set.date; color: Theme.muted; font-size: 14px; overflow: elide; accessible-role: none; }
            Text { text: root.set.edited; color: Theme.muted; font-size: 13px; overflow: elide; accessible-role: none; }
        }
    }
    SetActions {
        name: root.set.name;
        enabled: root.interactive;
        x: root.width - self.width - 2px;
        y: root.height - self.height - 2px;
        clicked => { root.more(); }
    }
}

// Dense alternative to SetFolderCard. Fixed height keeps ListView virtualization exact.
export component SetRow inherits Rectangle {
    in property <SetCard> set;
    in property <bool> interactive: true;
    callback open();
    callback more();
    height: 80px;
    border-radius: 18px;
    background: input.pressed ? Theme.field : transparent;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.set.name;
    accessible-description: root.set.date + ". " + root.set.count + ". " + @tr("Opens the set");
    accessible-action-default => { if root.interactive && !Theme.modal-open { root.open(); } }
    forward-focus: input;
    input := ActionInput {
        enabled: root.interactive && !Theme.modal-open;
        clicked => {
            self.focus();
            root.open();
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 14px;
                background: Theme.accent-soft;
                Glyph { kind: "folder"; ink: Theme.on-accent-soft; x: 13px; y: 13px; width: 26px; height: 26px; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.set.name; font-size: 17px; font-weight: 600; overflow: elide; color: Theme.foreground; accessible-role: none; }
            Text { text: root.set.date + " · " + root.set.count; font-size: 14px; overflow: elide; color: Theme.muted; accessible-role: none; }
        }
        Text {
            text: root.set.edited;
            width: 160px;
            font-size: 14px;
            color: Theme.muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            SetActions {
                name: root.set.name;
                enabled: root.interactive;
                clicked => { root.more(); }
            }
        }
    }
}

component SetGrid inherits Flickable {
    in property <[SetCard]> cards;
    in property <bool> items-enabled: true;
    callback open(string);
    callback more(SetCard);
    private property <length> gap: 16px;
    private property <length> row-gap: 24px;
    private property <int> columns: max(1, floor((self.width + self.gap) / 216px));
    private property <length> cell-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
    private property <length> cell-height: self.cell-width * 0.85 + 88px;
    content-height: ceil(root.cards.length / root.columns) * (self.cell-height + self.row-gap);
    // Content shrinking (deletes, rotation) must not leave the viewport scrolled past the end.
    function clamp-scroll() {
        root.content-y = clamp(root.content-y, -max(root.content-height - root.height, 0px), 0px);
    }
    changed content-height => { root.clamp-scroll(); }
    changed height => { root.clamp-scroll(); }
    for card[index] in root.cards : SetFolderCard {
        x: mod(index, root.columns) * (root.cell-width + root.gap);
        y: floor(index / root.columns) * (root.cell-height + root.row-gap);
        width: root.cell-width;
        height: root.cell-height;
        set: card;
        interactive: root.items-enabled;
        open => { root.open(card.id); }
        more => { root.more(card); }
    }
}

// The Sets section's content: folder cards, or set rows in the list layout.
export component SetsPane inherits Card {
    in property <[SetCard]> cards;
    in property <bool> list-view;
    in property <bool> items-enabled: true;
    callback open(string);
    callback more(SetCard);
    if !root.list-view : Rectangle {
        grid := SetGrid {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: parent.height - self.y;
            cards: root.cards;
            items-enabled: root.items-enabled;
            open(id) => { root.open(id); }
            more(card) => { root.more(card); }
        }
        Scrollbar {
            x: parent.width - self.width;
            y: grid.y;
            width: 48px;
            height: grid.height;
            content-height: grid.content-height;
            visible-height: grid.height;
            content-y: grid.content-y;
            scrolled(y) => { grid.content-y = y; }
        }
    }
    if root.list-view : Rectangle {
        list := ListView {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            for card in root.cards : SetRow {
                set: card;
                interactive: root.items-enabled;
                open => { root.open(card.id); }
                more => { root.more(card); }
            }
        }
        Scrollbar {
            x: parent.width - self.width;
            y: list.y;
            width: 48px;
            height: list.height;
            content-height: list.content-height;
            visible-height: list.visible-height;
            content-y: list.content-y;
            scrolled(y) => { list.content-y = y; }
        }
    }
}

component DialogLabel inherits Text {
    color: Theme.muted;
    font-size: 14px;
    font-weight: 600;
}

// A centred modal card over a scrim. `presence` fades it in and out; the scrim swallows input.
component SetModal inherits Rectangle {
    in property <float> presence;
    in property <length> card-width: 560px;
    in property <string> dialog-label;
    callback dismissed();
    Rectangle {
        background: #000000;
        opacity: root.presence * 0.4;
        TouchArea { }
    }
    card := Rectangle {
        width: min(root.width - 32px, root.card-width);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (1 - root.presence) * 32px;
        opacity: root.presence;
        background: Theme.card;
        border-radius: 26px;
        accessible-role: form;
        accessible-label: root.dialog-label;
        accessible-description: @tr("Modal dialog. Close or cancel to return to your library.");
        TouchArea { }
        content := VerticalLayout {
            padding: 28px;
            spacing: 20px;
            @children
        }
    }
}

// New set (empty `set-id`) or Edit set. Only an empty name is caught here; Rust validates the
// rest and reports through `error`.
export component SetDialog inherits FocusScope {
    in property <float> presence;
    in property <string> set-id;
    in-out property <string> name;
    in-out property <string> date;
    in-out property <string> notes;
    in-out property <string> error;
    callback saved(string, string, string, string);
    callback cancelled();
    function save() {
        if root.name == "" {
            root.error = @tr("Name is required");
        } else {
            root.saved(root.set-id, root.name, root.date, root.notes);
        }
    }
    init => { name-field.focus(); }
    key-pressed(event) => {
        if event.text == Key.Escape || event.text == Key.Back {
            root.cancelled();
            return accept;
        }
        return reject;
    }
    SetModal {
        width: root.width;
        height: root.height;
        presence: root.presence;
        dialog-label: @tr("Set details dialog");
        VerticalLayout {
            spacing: 6px;
            Text { text: root.set-id == "" ? @tr("New set") : @tr("Edit set"); color: Theme.foreground; font-size: 24px; font-weight: 600; }
            if root.set-id == "" : Text { text: @tr("Only the name is required. You add pieces after saving."); color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        }
        VerticalLayout {
            spacing: 8px;
            DialogLabel { text: @tr("Name"); }
            name-field := TextField { in-dialog: true; text <=> root.name; placeholder: @tr("Set name"); }
        }
        VerticalLayout {
            spacing: 8px;
            DialogLabel { text: @tr("Date (optional)"); }
            HorizontalLayout {
                spacing: 8px;
                TextField { in-dialog: true; text <=> root.date; placeholder: @tr("YYYY-MM-DD"); horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        in-dialog: true;
                        label: @tr("Clear date");
                        icon: @image-url("material-icons/close.svg");
                        enabled: root.date != "";
                        clicked => { root.date = ""; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            DialogLabel { text: @tr("Notes (optional)"); }
            TextField { in-dialog: true; text <=> root.notes; placeholder: @tr("Occasion, time, cantor…"); }
        }
        if root.error != "" : Text { text: root.error; color: Theme.error; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton { in-dialog: true; text: @tr("Cancel"); clicked => { root.cancelled(); } }
            PillButton { in-dialog: true; text: @tr("Save set"); primary: true; clicked => { root.save(); } }
        }
    }
}

// Asks before a set is deleted, naming it. Its pieces stay in the library.
export component DeleteSetDialog inherits FocusScope {
    in property <float> presence;
    in property <string> name;
    callback confirmed();
    callback cancelled();
    // Keeps the name while the dialog fades out after Rust clears `name`.
    private property <string> shown-name;
    changed name => { if root.name != "" { root.shown-name = root.name; } }
    init => {
        root.shown-name = root.name;
        cancel-button.focus();
    }
    key-pressed(event) => {
        if event.text == Key.Escape || event.text == Key.Back {
            root.cancelled();
            return accept;
        }
        return reject;
    }
    SetModal {
        width: root.width;
        height: root.height;
        presence: root.presence;
        card-width: 480px;
        dialog-label: @tr("Delete set dialog");
        VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Delete “{0}”?", root.shown-name); color: Theme.foreground; font-size: 24px; font-weight: 600; wrap: word-wrap; }
            Text { text: @tr("The set is removed. Its pieces stay in your library."); color: Theme.muted; font-size: 14px; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            cancel-button := PillButton { in-dialog: true; text: @tr("Cancel"); clicked => { root.cancelled(); } }
            PillButton {
                in-dialog: true;
                text: @tr("Delete");
                icon: @image-url("material-icons/delete.svg");
                primary: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
