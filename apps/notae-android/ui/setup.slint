// First run, folder recovery and settings in the One UI style.
import { ScrollView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, PillButton, Card } from "components.slint";

component FeatureRow inherits HorizontalLayout {
    in property <string> kind;
    in property <string> heading;
    in property <string> detail;
    min-height: 80px;
    spacing: 18px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: Theme.accent-soft;
            Glyph { kind: root.kind; ink: Theme.on-accent-soft; x: 10px; y: 10px; }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text { text: root.heading; color: Theme.foreground; font-size: 16px; font-weight: 600; }
        Text { text: root.detail; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
    }
}

export component WelcomeScreen inherits Rectangle {
    in property <length> available-width;
    in property <bool> recovery;
    in property <string> folder;
    in property <string> error-text;
    callback accepted();
    background: Theme.background;
    VerticalLayout {
        padding-top: 96px;
        padding-bottom: 40px;
        alignment: start;
        spacing: 20px;
        HorizontalLayout { alignment: center; Image { source: @image-url("assets/notae.svg"); width: 96px; height: 96px; } }
        Text {
            text: root.recovery ? "Reconnect your library" : "Welcome to Notae";
            color: Theme.foreground; font-size: 40px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: min(560px, max(1px, root.available-width - 32px));
                text: root.recovery
                    ? "Notae no longer has access to “" + root.folder + "”. Choose it again to reconnect your scores."
                    : "Your sheet music, in good order. Notae reads your PDFs where they are and opens them in the PDF app you already use.";
                color: Theme.muted; font-size: 17px; horizontal-alignment: center; wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: center;
            Card {
                width: min(560px, max(1px, root.available-width - 32px));
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    FeatureRow { kind: "folder"; heading: "Files stay where they are"; detail: "Nothing is moved, renamed or uploaded"; }
                    Rectangle { height: 1px; background: Theme.divider; }
                    FeatureRow { kind: "search"; heading: "Find any score fast"; detail: "Search by title, composer, tag or lyrics"; }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        if root.error-text != "" : Text { text: root.error-text; color: Theme.error; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center;
            PillButton { width: 360px; text: root.recovery ? "Reconnect folder" : "Choose score folder"; primary: true; clicked => { root.accepted(); } }
        }
        Text { text: "Device storage or SD card"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <length> available-width;
    in property <length> available-height;
    in property <string> library-display-name;
    in property <string> scan-summary;
    in property <string> pending-text-count;
    in property <string> version;
    callback back();
    callback change-library();
    max-height: root.available-height;
    background: Theme.background;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            IconButton { label: "Back to library"; icon: @image-url("material-icons/arrow-back.svg"); clicked => { root.back(); } }
            Text { text: "Settings"; color: Theme.foreground; font-size: 32px; font-weight: 600; vertical-alignment: center; }
        }
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                width: min(720px, max(1px, root.available-width - 32px));
                spacing: 12px;
                Card {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        Text { text: "Library location"; color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        Text { text: root.library-display-name; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
                        PillButton { text: "Change folder"; tonal: true; clicked => { root.change-library(); } }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        Text { text: "Library maintenance"; color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        Text { text: root.scan-summary; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
                        Text {
                            text: root.pending-text-count + " scores have text pending. Android does not run OCR; desktop OCR or sidecar import is an available next step.";
                            color: Theme.muted;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        Text { text: "Local storage and privacy"; color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        Text {
                            text: "PDFs stay in their selected folder. The index and thumbnails are stored locally on this device.";
                            color: Theme.muted;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        Text { text: "About"; color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        Text { text: "Notae " + root.version; color: Theme.muted; font-size: 15px; }
                        Text { text: "A personal library for sheet music."; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}
