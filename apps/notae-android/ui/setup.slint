// First run, folder recovery and settings in the One UI style.
import { ScrollView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, ScanButton, PillButton, Card, ActionInput } from "components.slint";
import { OperationBanner } from "library.slint";
import { Scrollbar } from "scrollbar.slint";

component FeatureRow inherits HorizontalLayout {
    in property <string> kind;
    in property <string> heading;
    in property <string> detail;
    min-height: 80px;
    spacing: 18px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: Theme.accent-soft;
            Glyph { kind: root.kind; ink: Theme.on-accent-soft; x: 10px; y: 10px; }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text { text: root.heading; color: Theme.foreground; font-size: 16px; font-weight: 600; }
        Text { text: root.detail; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
    }
}

component FactRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.foreground;
    spacing: 12px;
    Text { text: root.label; color: Theme.muted; font-size: 15px; vertical-alignment: top; }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 15px;
        wrap: word-wrap;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        accessible-role: text;
        accessible-label: root.label + ": " + root.value;
    }
}

// One option in a single-choice list; the chosen one carries a check mark.
component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 52px;
    border-radius: 18px;
    background: input.pressed ? Theme.field : transparent;
    animate background { duration: Theme.motion-short; easing: ease-in-out; }
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.selected ? @tr("Selected") : "";
    accessible-action-default => { if !Theme.modal-open { root.clicked(); } }
    forward-focus: input;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 14px;
        Text { text: root.label; color: Theme.foreground; font-size: 16px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if root.selected : VerticalLayout { alignment: center; Glyph { kind: "check"; ink: Theme.accent; } }
    }
    input := ActionInput {
        enabled: !Theme.modal-open;
        clicked => { self.focus(); root.clicked(); }
    }
}

export component WelcomeScreen inherits Rectangle {
    in property <length> available-width;
    in property <length> available-height;
    in property <bool> recovery;
    in property <string> folder;
    in property <string> error-text;
    callback accepted();
    // Content column shared by the intro text, feature card and button.
    private property <length> column: min(560px, max(1px, root.available-width - 32px));
    background: Theme.background;
    VerticalLayout {
        padding-bottom: 24px;
        spacing: 20px;
        // Tall windows keep the intro, card and action together at the top; none of them stretches.
        alignment: start;
        // Short landscape windows cannot fit the whole introduction, so it scrolls above the fixed action.
        Rectangle {
            vertical-stretch: 0;
            preferred-height: intro.preferred-height;
            intro-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                intro := VerticalLayout {
                width: root.available-width;
                alignment: start;
                padding-top: max(16px, min(64px, (root.available-height - 640px) / 6));
                spacing: 20px;
                HorizontalLayout { alignment: center; Image { source: @image-url("assets/notae.png"); image-fit: contain; width: 96px; height: 96px; accessible-role: none; } }
                Text {
                    text: root.recovery ? @tr("Reconnect your library") : @tr("Welcome to Notae");
                    color: Theme.foreground; font-size: root.available-width < 420px ? 32px : 40px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; accessible-role: text; accessible-label: root.recovery ? @tr("Reconnect your library") : @tr("Welcome to Notae");
                }
                // Paragraph and feature card read as one group: 12 px apart, unlike the 20 px between other blocks.
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            width: root.column;
                            text: root.recovery
                                ? @tr("Notae no longer has access to “{}”. Choose it again to reconnect your scores.", root.folder)
                                : @tr("Your sheet music, in good order. Notae reads your PDFs where they are and opens them in the PDF app you already use.");
                            color: Theme.muted; font-size: 17px; horizontal-alignment: center; wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Card {
                            width: root.column;
                            VerticalLayout {
                                alignment: start;
                                padding-left: 24px;
                                padding-right: 24px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                FeatureRow { kind: "folder"; heading: @tr("Files stay where they are"); detail: @tr("Nothing is moved, renamed or uploaded"); }
                                Rectangle { height: 1px; background: Theme.divider; }
                                FeatureRow { kind: "search"; heading: @tr("Find any score fast"); detail: @tr("Search by title, composer, tag or lyrics"); }
                            }
                        }
                    }
                }
            }
        }
            Scrollbar {
                x: parent.width - self.width;
                y: 0px;
                width: 48px;
                height: parent.height;
                content-height: intro-scroll.content-height;
                visible-height: intro-scroll.visible-height;
                content-y: intro-scroll.content-y;
                scrolled(y) => { intro-scroll.content-y = y; }
            }
        }
        if root.error-text != "" : Text { text: root.error-text; color: Theme.error; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center;
            PillButton { width: min(360px, root.column); text: root.recovery ? @tr("Reconnect folder") : @tr("Choose score folder"); primary: true; clicked => { root.accepted(); } }
        }
        Text { text: @tr("Pick a folder on device storage or an SD card."); color: Theme.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <length> available-width;
    in property <length> available-height;
    in property <string> library-display-name;
    in property <string> indexed-count;
    in property <string> no-text-count;
    in property <string> scan-summary;
    in property <string> scan-conflicts;
    in property <string> scan-failures;
    in property <string> version;
    in property <string> build-identity;
    in property <string> repository;
    in property <string> license;
    in property <string> progress-text;
    in property <bool> busy;
    in property <bool> failed;
    in property <float> fraction;
    in property <bool> cancel-enabled;
    in property <bool> acknowledge-enabled;
    // 0 follows the system language, 1 is English, 2 is Polish (see `LanguageChoice::index`).
    in property <int> language-choice;
    callback language-chosen(int);
    in property <string> backup-status;
    callback export-sets();
    callback back();
    callback change-library();
    callback cancel();
    callback acknowledge();
    private property <length> pad: 16px;
    max-height: root.available-height;
    background: Theme.background;
    VerticalLayout {
        padding: root.pad;
        padding-bottom: 0px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; IconButton { label: @tr("Back to library"); icon: @image-url("material-icons/arrow-back.svg"); clicked => { root.back(); } } }
            Text { text: @tr("Settings"); color: Theme.foreground; font-size: root.available-width < 420px ? 26px : 32px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.progress-text != "" : OperationBanner {
            text: root.progress-text;
            busy: root.busy;
            failed: root.failed;
            fraction: root.fraction;
            cancel-enabled: root.cancel-enabled;
            acknowledge-enabled: root.acknowledge-enabled;
            cancel => { root.cancel(); }
            acknowledge => { root.acknowledge(); }
        }
        Rectangle {
            vertical-stretch: 1;
            body := ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                width: min(720px, max(1px, root.available-width - 2 * root.pad));
                padding-bottom: root.pad;
                spacing: 12px;
                alignment: start;
                Card {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        spacing: 4px;
                        Text { text: @tr("Library folder"); color: Theme.muted; font-size: 13px; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.library-display-name; color: Theme.foreground; font-size: 15px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; accessible-role: text; accessible-label: root.library-display-name; }
                            VerticalLayout { alignment: center; PillButton { text: @tr("Change"); tonal: true; clicked => { root.change-library(); } } }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        spacing: 8px;
                        Text { text: @tr("Library maintenance"); color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        FactRow { label: @tr("Indexed scores"); value: root.indexed-count; }
                        FactRow { label: @tr("PDFs without extractable text"); value: root.no-text-count; }
                        FactRow { label: @tr("Last scan"); value: root.scan-summary; }
                        if root.scan-conflicts != "" : FactRow {
                            label: @tr("ID conflicts");
                            value: root.scan-conflicts;
                            value-color: root.scan-conflicts == "0" ? Theme.foreground : Theme.error;
                        }
                        if root.scan-failures != "" : FactRow {
                            label: @tr("Failures");
                            value: root.scan-failures;
                            value-color: root.scan-failures == "0" ? Theme.foreground : Theme.error;
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        spacing: 8px;
                        Text { text: @tr("About Notae"); color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        FactRow { label: @tr("Version"); value: root.version; }
                        FactRow { label: @tr("Build"); value: root.build-identity; }
                        FactRow { label: @tr("License"); value: root.license; }
                        FactRow { label: @tr("Repository"); value: root.repository; }
                        Text { text: @tr("Your library stays on this device. Notae does not send data over the network."); color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        spacing: 8px;
                        Text { text: @tr("Language"); color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        ChoiceRow { label: @tr("System default"); selected: root.language-choice == 0; clicked => { root.language-chosen(0); } }
                        // Language names stay in their own language so anyone can find theirs.
                        ChoiceRow { label: "English"; selected: root.language-choice == 1; clicked => { root.language-chosen(1); } }
                        ChoiceRow { label: "Polski"; selected: root.language-choice == 2; clicked => { root.language-chosen(2); } }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        spacing: 8px;
                        Text { text: @tr("Sets and favorites"); color: Theme.foreground; font-size: 18px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: start;
                            PillButton { text: @tr("Export sets"); tonal: true; clicked => { root.export-sets(); } }
                        }
                        if root.backup-status != "" : Text { text: root.backup-status; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                    }
                }
            }
        }
            Scrollbar {
                x: parent.width - self.width;
                y: 0px;
                width: 48px;
                height: parent.height;
                content-height: body.content-height;
                visible-height: body.visible-height;
                content-y: body.content-y;
                scrolled(y) => { body.content-y = y; }
            }
        }
    }
}
