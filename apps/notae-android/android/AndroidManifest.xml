<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference AndroidManifest for `notae-android`.

  `cargo-apk2` generates the packaged manifest from
  `[package.metadata.android]` and compiles the Java result adapter
  under `android/src/main/java`.

  The launcher is `org.notae.android.NotaeActivity`, a Java subclass
  of `android.app.NativeActivity`; the inherited native startup loads
  `libnotae_android.so` and calls the Rust `android_main` entry point.
  Its `android.app.lib_name` metadata and MAIN/LAUNCHER filter are
  declared in Cargo.toml.

  The packaged manifest is written under `target/release/apk/` by
  `cargo apk2 build --release -p notae-android`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.notae.android">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <application android:label="Notae" android:hasCode="true">
        <activity android:name=".NotaeActivity"
                  android:exported="true"
                  android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.lib_name"
                       android:value="notae_android" />
        </activity>
    </application>
</manifest>
